# Copy this file to ".env.local" and fill in your own Stripe test keys.
# Get them from https://dashboard.stripe.com/test/apikeys

# Secret key (server only — never expose to the browser). Starts with sk_test_
STRIPE_SECRET_KEY=sk_test_xxx

# Base URL Stripe redirects back to after checkout.
# Local dev:
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Webhook signing secret — printed by `stripe listen` (local) or shown in the
# Dashboard when you add a webhook endpoint. Starts with whsec_
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Anthropic API key — powers "Импортиране от доставчик": auto-translates
# supplier product names/descriptions to Bulgarian. Get one at
# https://console.anthropic.com/ . Without it, import still works but skips
# translation (keeps the original language). Starts with sk-ant-
ANTHROPIC_API_KEY=sk-ant-xxx

# Admin panel login. Open /admin, log in with this password.
ADMIN_PASSWORD=change-me-to-a-strong-password
# Optional: secret used to sign the admin session cookie (any long random string).
ADMIN_SESSION_SECRET=change-me-too

# ---- SEO / Analytics ----
# Your live domain — used for canonical URLs, sitemap, schema and social sharing.
NEXT_PUBLIC_SITE_URL=https://lipko.bg

# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX). Leave empty to
# disable analytics. Create one at https://analytics.google.com
NEXT_PUBLIC_GA_ID=

# Public contact email shown in FAQ, privacy policy and footer.
NEXT_PUBLIC_CONTACT_EMAIL=info@lipko.bg
