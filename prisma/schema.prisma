// Prisma schema. Local dev uses SQLite (zero setup). For production, change the
// datasource `provider` to "postgresql" and point DATABASE_URL at your hosted DB
// (Supabase, Neon, RDS…) — the models and app code stay exactly the same.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        String   @id
  name      String
  price     Float // продажна цена в лева (BGN)
  oldPrice  Float? // стара цена в лева (BGN) — зачертана при промоция
  cost      Float? // покупна/доставна цена в лева (BGN) — за печалба/марж
  emoji     String
  images    String? // JSON масив от пътища; първата е основна, напр. ["/uploads/a.jpg","/uploads/b.jpg"]
  variants  String? // JSON: групи варианти, напр. [{"label":"Цвят","options":["Син","Зелен"]}]
  video     String? // YouTube/Vimeo линк или качен файл /uploads/xyz.mp4
  category  String
  material  String
  age       String
  rating    Float    @default(4.8)
  reviews   Int      @default(0)
  tag       String? // "Хит" | "Ново" | null
  dim       String
  desc      String
  stock     Int      @default(0)
  active    Boolean  @default(true)
  promo     Boolean  @default(false) // на промоция — показва се на лендинг страницата
  featured  Boolean  @default(false) // ръчно избран за „Най-търсени“ на началната страница
  supplierUrl String? // линк към продукта в сайта на доставчика (напр. Faire)
  shipsFrom   String? // държава, от която се доставя артикулът, напр. "Германия"
  supplierMinimum Float? // минимална поръчка при доставчика (марката във Faire), в евро
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String      @id // Stripe Checkout Session id
  createdAt       DateTime    @default(now())
  email           String? // съхранява се с малки букви за търсене
  name            String?
  amountTotal     Float
  currency        String
  shippingAddress String?
  paymentStatus   String? // от Stripe: paid / unpaid
  status          String      @default("Обработва се") // изпълнение на поръчката
  tracking        String?
  items           OrderItem[]
  accountId       String? // клиентски профил, ако е поръчал влязъл в профила си
  account         Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([accountId])
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  productId String?
  name      String
  quantity  Int
  amount    Float
}

model Setting {
  key   String @id
  value String
}

// Клиентски профил (имейл + парола). Пази любимите и свързва поръчките,
// направени докато клиентът е влязъл.
model Account {
  id           String     @id @default(cuid())
  email        String     @unique // с малки букви
  name         String?
  passwordHash String // scrypt: salt:hash
  createdAt    DateTime   @default(now())
  favorites    Favorite[]
  orders       Order[]
}

model Favorite {
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  productId String
  createdAt DateTime @default(now())

  @@id([accountId, productId])
}
